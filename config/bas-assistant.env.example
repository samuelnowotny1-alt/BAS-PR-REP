# BAS Assistant production environment

BAS_ENVIRONMENT=production
BAS_DEBUG=false
BAS_HOST=127.0.0.1
BAS_PORT=8000
BAS_LOG_LEVEL=INFO
BAS_LOG_DIR=/home/bas/bas-assistant/logs
BAS_DATA_DIR=/home/bas/bas-assistant/data
BAS_OUTPUT_DIR=/home/bas/bas-assistant/output
BAS_UPLOADS_DIR=/home/bas/bas-assistant/uploads
BAS_STATIC_DIR=/home/bas/bas-assistant/ui/static
BAS_TEMPLATES_DIR=/home/bas/bas-assistant/ui/templates
BAS_DATABASE_URL=sqlite:////home/bas/bas-assistant/data/bas_assistant.db
BAS_SESSION_SECRET=replace-with-a-long-random-secret
BAS_BOOTSTRAP_ADMIN_USERNAME=admin
BAS_BOOTSTRAP_ADMIN_PASSWORD=change-this-immediately
BAS_BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
