{
  "name": "RTU-1 Control Logic",
  "type": "sequence",
  "equipment": "RTU-1",
  "blocks": [
    {
      "id": "mode_select",
      "type": "mode",
      "name": "AHU Mode Selection",
      "inputs": [
        "occ_command",
        "oa_temp",
        "sat_sp",
        "mode",
        "enable_fan"
      ],
      "outputs": [
        "sat_sp",
        "mode",
        "enable_fan"
      ],
      "parameters": {
        "warmup_oa_threshold": "40",
        "cooldown_oa_threshold": "75"
      }
    },
    {
      "id": "fan_control",
      "type": "start_stop",
      "name": "Supply Fan Control",
      "inputs": [
        "fan_cmd",
        "fan_status",
        "fan_vfd_speed",
        "fan_alarm",
        "fan_runtime"
      ],
      "outputs": [
        "fan_vfd_speed",
        "fan_alarm",
        "fan_runtime"
      ],
      "parameters": {
        "proof_timeout": "30",
        "min_speed": "20",
        "max_speed": "100"
      }
    },
    {
      "id": "sat_control",
      "type": "pid",
      "name": "Supply Air Temperature Control",
      "inputs": [
        "sat",
        "sat_sp",
        "clg_valve_cmd",
        "htg_valve_cmd",
        "sat_error"
      ],
      "outputs": [
        "clg_valve_cmd",
        "htg_valve_cmd",
        "sat_error"
      ],
      "parameters": {
        "kp": "0.5",
        "ki": "0.02",
        "kd": "0",
        "deadband": "1.0",
        "output_min": "0",
        "output_max": "100"
      }
    },
    {
      "id": "economizer",
      "type": "economizer",
      "name": "Airside Economizer",
      "inputs": [
        "oa_temp",
        "oa_hum",
        "ra_temp",
        "ra_hum",
        "econ_enable",
        "damper_cmd",
        "econ_savings"
      ],
      "outputs": [
        "econ_enable",
        "damper_cmd",
        "econ_savings"
      ],
      "parameters": {
        "high_limit_temp": "70",
        "high_limit_enthalpy": "28",
        "diff_temp_enable": "2",
        "diff_enthalpy_enable": "2"
      }
    },
    {
      "id": "freeze_protection",
      "type": "freeze_protection",
      "name": "Freeze Protection",
      "inputs": [
        "sat",
        "mat",
        "freeze_stat",
        "htg_valve_override",
        "fan_stop",
        "freeze_alarm"
      ],
      "outputs": [
        "htg_valve_override",
        "fan_stop",
        "freeze_alarm"
      ],
      "parameters": {
        "sat_trip": "35",
        "mat_trip": "38",
        "override_position": "100"
      }
    },
    {
      "id": "static_protection",
      "type": "high_limit",
      "name": "Static Pressure Protection",
      "inputs": [
        "duct_sp",
        "fan_speed_limit",
        "high_static_alarm",
        "low_static_alarm"
      ],
      "outputs": [
        "fan_speed_limit",
        "high_static_alarm",
        "low_static_alarm"
      ],
      "parameters": {
        "high_limit": "4.0",
        "low_limit": "0.2",
        "high_limit_action": "ramp_down",
        "low_limit_action": "alarm_only"
      }
    },
    {
      "id": "smoke_interlock",
      "type": "interlock",
      "name": "Smoke/Fire Interlocks",
      "inputs": [
        "duct_smoke",
        "area_smoke",
        "fire_alarm",
        "shutdown",
        "smoke_alarm"
      ],
      "outputs": [
        "shutdown",
        "smoke_alarm"
      ],
      "parameters": {
        "shutdown_delay": "0"
      }
    },
    {
      "id": "alarm_rtu_1_oat",
      "type": "alarm",
      "name": "Alarm: RTU-1 OAT",
      "inputs": [
        "RTU-1 OAT",
        "RTU-1 OAT_high_alm",
        "RTU-1 OAT_low_alm"
      ],
      "outputs": [
        "RTU-1 OAT_high_alm",
        "RTU-1 OAT_low_alm"
      ],
      "parameters": {
        "high_limit": "120.0",
        "low_limit": "-20.0",
        "deadband": "1",
        "delay": "30"
      }
    },
    {
      "id": "alarm_rtu_1_oa_hum",
      "type": "alarm",
      "name": "Alarm: RTU-1 OA HUM",
      "inputs": [
        "RTU-1 OA HUM",
        "RTU-1 OA HUM_high_alm",
        "RTU-1 OA HUM_low_alm"
      ],
      "outputs": [
        "RTU-1 OA HUM_high_alm",
        "RTU-1 OA HUM_low_alm"
      ],
      "parameters": {
        "high_limit": "100.0",
        "low_limit": "0",
        "deadband": "1",
        "delay": "30"
      }
    },
    {
      "id": "alarm_rtu_1_mat",
      "type": "alarm",
      "name": "Alarm: RTU-1 MAT",
      "inputs": [
        "RTU-1 MAT",
        "RTU-1 MAT_high_alm",
        "RTU-1 MAT_low_alm"
      ],
      "outputs": [
        "RTU-1 MAT_high_alm",
        "RTU-1 MAT_low_alm"
      ],
      "parameters": {
        "high_limit": "95.0",
        "low_limit": "35.0",
        "deadband": "1",
        "delay": "30"
      }
    },
    {
      "id": "alarm_rtu_1_rat",
      "type": "alarm",
      "name": "Alarm: RTU-1 RAT",
      "inputs": [
        "RTU-1 RAT",
        "RTU-1 RAT_high_alm",
        "RTU-1 RAT_low_alm"
      ],
      "outputs": [
        "RTU-1 RAT_high_alm",
        "RTU-1 RAT_low_alm"
      ],
      "parameters": {
        "high_limit": "85.0",
        "low_limit": "60.0",
        "deadband": "1",
        "delay": "30"
      }
    },
    {
      "id": "alarm_rtu_1_ra_hum",
      "type": "alarm",
      "name": "Alarm: RTU-1 RA HUM",
      "inputs": [
        "RTU-1 RA HUM",
        "RTU-1 RA HUM_high_alm",
        "RTU-1 RA HUM_low_alm"
      ],
      "outputs": [
        "RTU-1 RA HUM_high_alm",
        "RTU-1 RA HUM_low_alm"
      ],
      "parameters": {
        "high_limit": "85.0",
        "low_limit": "15.0",
        "deadband": "1",
        "delay": "30"
      }
    },
    {
      "id": "alarm_rtu_1_sat",
      "type": "alarm",
      "name": "Alarm: RTU-1 SAT",
      "inputs": [
        "RTU-1 SAT",
        "RTU-1 SAT_high_alm",
        "RTU-1 SAT_low_alm"
      ],
      "outputs": [
        "RTU-1 SAT_high_alm",
        "RTU-1 SAT_low_alm"
      ],
      "parameters": {
        "high_limit": "85.0",
        "low_limit": "45.0",
        "deadband": "1",
        "delay": "30"
      }
    },
    {
      "id": "alarm_rtu_1_duct_sp",
      "type": "alarm",
      "name": "Alarm: RTU-1 DUCT SP",
      "inputs": [
        "RTU-1 DUCT SP",
        "RTU-1 DUCT SP_high_alm",
        "RTU-1 DUCT SP_low_alm"
      ],
      "outputs": [
        "RTU-1 DUCT SP_high_alm",
        "RTU-1 DUCT SP_low_alm"
      ],
      "parameters": {
        "high_limit": "4.0",
        "low_limit": "0",
        "deadband": "1",
        "delay": "30"
      }
    },
    {
      "id": "alarm_rtu_1_sf_cmd",
      "type": "alarm",
      "name": "Alarm: RTU-1 SF CMD",
      "inputs": [
        "RTU-1 SF CMD",
        "RTU-1 SF CMD_high_alm",
        "RTU-1 SF CMD_low_alm"
      ],
      "outputs": [
        "RTU-1 SF CMD_high_alm",
        "RTU-1 SF CMD_low_alm"
      ],
      "parameters": {
        "high_limit": "100.0",
        "low_limit": "0",
        "deadband": "1",
        "delay": "30"
      }
    },
    {
      "id": "alarm_rtu_1_clg_valve",
      "type": "alarm",
      "name": "Alarm: RTU-1 CLG VALVE",
      "inputs": [
        "RTU-1 CLG VALVE",
        "RTU-1 CLG VALVE_high_alm",
        "RTU-1 CLG VALVE_low_alm"
      ],
      "outputs": [
        "RTU-1 CLG VALVE_high_alm",
        "RTU-1 CLG VALVE_low_alm"
      ],
      "parameters": {
        "high_limit": "100.0",
        "low_limit": "0",
        "deadband": "1",
        "delay": "30"
      }
    },
    {
      "id": "alarm_rtu_1_htg_valve",
      "type": "alarm",
      "name": "Alarm: RTU-1 HTG VALVE",
      "inputs": [
        "RTU-1 HTG VALVE",
        "RTU-1 HTG VALVE_high_alm",
        "RTU-1 HTG VALVE_low_alm"
      ],
      "outputs": [
        "RTU-1 HTG VALVE_high_alm",
        "RTU-1 HTG VALVE_low_alm"
      ],
      "parameters": {
        "high_limit": "100.0",
        "low_limit": "0",
        "deadband": "1",
        "delay": "30"
      }
    },
    {
      "id": "alarm_rtu_1_oa_damper",
      "type": "alarm",
      "name": "Alarm: RTU-1 OA DAMPER",
      "inputs": [
        "RTU-1 OA DAMPER",
        "RTU-1 OA DAMPER_high_alm",
        "RTU-1 OA DAMPER_low_alm"
      ],
      "outputs": [
        "RTU-1 OA DAMPER_high_alm",
        "RTU-1 OA DAMPER_low_alm"
      ],
      "parameters": {
        "high_limit": "100.0",
        "low_limit": "0",
        "deadband": "1",
        "delay": "30"
      }
    },
    {
      "id": "alarm_rtu_1_filter_dp",
      "type": "alarm",
      "name": "Alarm: RTU-1 FILTER DP",
      "inputs": [
        "RTU-1 FILTER DP",
        "RTU-1 FILTER DP_high_alm",
        "RTU-1 FILTER DP_low_alm"
      ],
      "outputs": [
        "RTU-1 FILTER DP_high_alm",
        "RTU-1 FILTER DP_low_alm"
      ],
      "parameters": {
        "high_limit": "3.0",
        "low_limit": "0",
        "deadband": "1",
        "delay": "30"
      }
    }
  ],
  "wires": [
    {
      "from": "mode_select.enable_fan",
      "to": "fan_control.fan_cmd"
    },
    {
      "from": "mode_select.sat_sp",
      "to": "sat_control.sat_sp"
    }
  ]
}